# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only these Supabase Auth users can enter /admin
ADMIN_EMAILS=you@example.com
ADMIN_SESSION_SECRET=

# Google OAuth / Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# 32 random bytes encoded as base64
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DRIVE_TOKEN_ENCRYPTION_KEY=

# Random secret for password-gallery access cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GALLERY_ACCESS_SECRET=
